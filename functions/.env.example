# Firebase Configuration
FIREBASE_PROJECT_ID=mbank-32d6d

# Twilio Configuration (for SMS OTP)
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# SendGrid Configuration (for Email OTP)
# Sign up at: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@cashelan.com
SENDGRID_FROM_NAME=Cash Elan Bank

# Encryption Key (Generate a secure random string)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate_a_secure_random_key_here

# App Configuration
APP_NAME=Cash Elan
APP_URL=https://cashelan.com
SUPPORT_EMAIL=support@cashelan.com

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_ATTEMPTS=5

# Transaction Limits (in PHP)
DAILY_TRANSFER_LIMIT=50000
SINGLE_TRANSFER_LIMIT=50000
MONTHLY_TRANSFER_LIMIT=500000
